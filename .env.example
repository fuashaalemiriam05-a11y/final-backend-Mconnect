# ===== Mentor Connect backend configuration =====
# Copy this file to ".env" and fill in YOUR values.

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
# Default local PostgreSQL install example:
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/mconnect?schema=public"

# Secret used to sign login tokens. Change this to anything long & random.
JWT_SECRET="change-me-to-a-long-random-string"

# Port the backend API listens on (frontend dev server proxies /api to this).
PORT=3002

# Public URL used in password-reset emails (set to your machine's LAN IP for phone testing).
FRONTEND_URL="http://localhost:5173"

# Optional email SMTP settings. If omitted, the app uses a test (Ethereal) account
# and prints a preview link in the backend console.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="Mentor Connect <no-reply@mconnect.com>"
